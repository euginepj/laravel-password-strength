{
    "name": "euginepj/laravel-password-strength",
    "description": "Comprehensive password strength analyzer, scoring engine, and validation rule package for Laravel.",
    "keywords": ["laravel", "password", "password-strength", "security", "validation", "entropy"],
    "homepage": "https://github.com/euginepj/laravel-password-strength",
    "license": "MIT",
    "authors": [
        {
            "name": "Eugine",
            "homepage": "https://github.com/euginepj"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/translation": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Euginepj\\PasswordStrength\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Euginepj\\PasswordStrength\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Euginepj\\PasswordStrength\\PasswordStrengthServiceProvider"
            ],
            "aliases": {
                "PasswordStrength": "Euginepj\\PasswordStrength\\Facades\\PasswordStrength"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
